# Backorder Reliability Agent - copy to .env for local runs. On Cloud Foundry use `cf set-env` / manifest.yml.

# --- SAP S/4HANA (DMS OTC MT2) ------------------------------------------------------------------
# mock        : simulated DMS system with sample materials (default, no connectivity needed)
# destination : SAP BTP Destination service (+ Connectivity/Cloud Connector for OnPremise). BTP only.
# direct      : call SAP_BASE_URL yourself (S/4 host reachable from here, or a CPI iFlow proxy)
SAP_CONNECTION_MODE=mock
SAP_SYSTEM_LABEL=DMS OTC MT2 (client 100)

# destination mode
SAP_DESTINATION_NAME=DMS_MT2_S4

# direct mode - S/4 host (needs J&J network) with basic auth ...
# SAP_BASE_URL=https://mtdev.jnj.com
# SAP_AUTH_TYPE=basic
# SAP_USERNAME=
# SAP_PASSWORD=
# ... or a CPI iFlow that proxies the two OData services, with the CPI runtime client-credentials key
# SAP_BASE_URL=https://<tenant>.it-cpi<nnn>-rt.cfapps.us10-<nnn>.hana.ondemand.com/http/<iflow-path>
# SAP_AUTH_TYPE=oauth2_client_credentials
# SAP_TOKEN_URL=https://<subdomain>.authentication.us10.hana.ondemand.com/oauth/token
# SAP_CLIENT_ID=
# SAP_CLIENT_SECRET=

# sap-client query parameter (leave empty if the destination already sets it)
# SAP_CLIENT=100
# SAP_CSRF=true
# SAP_TIMEOUT_MS=20000

# Service roots (override if a proxy exposes different paths)
# SAP_AVAILABILITY_SERVICE_PATH=/sap/opu/odata4/sap/api_product_availy_info/srvd_a2x/sap/apiproductavailyinfo/0001/
# SAP_ATP_SERVICE_PATH=/sap/opu/odata4/sap/api_avail_to_promise_check/srvd_a2x/sap/apiavailtopromisecheck/0001/

# --- aATP request parameters ----------------------------------------------------------------------
# ATP_CHECKING_RULE=A
# ATP_CONSIDER_PRODUCT_ALLOCATION=true
# ATP_DOCUMENT_PURPOSE=SLS
# ATP_REQUEST_TIME_UTC=18:00:00
# Characteristic catalog names sent with the aATP check (SD_I-SHIPPINGPOINT is mandatory per SAP KBA 3691877)
# ATP_CHARACTERISTICS=SD-CUSTOMERGROUP,SD_I-SHIPPINGPOINT,SD-SALESDOCUMENTTYPE,SD_I_PAR_PF.WE-CUSTOMER
# Characteristics for the availability time series (supply protection matching); empty = none
# AVAILABILITY_CHARACTERISTICS=
# DEFAULT_UNIT=EA

# --- Reliability rules ----------------------------------------------------------------------------
# Availability vs ATP difference (as % of requested qty) that counts as a "material gap"
# RULE_GAP_TOLERANCE_PCT=10

# --- OMP planned supply (second call) -------------------------------------------------------------
# mock | direct | destination | off
OMP_CONNECTION_MODE=mock
# OMP_BASE_URL=
# OMP_DESTINATION_NAME=
# OMP_AUTH_TYPE=none
# OMP_PROJECTION_PATH=/projected-inventory?material={material}&plant={plant}&fromDate={fromDate}&toDate={toDate}
# OMP_HORIZON_DAYS=90

# --- SAP AI Core (orchestration) ------------------------------------------------------------------
# Local: paste the service key JSON on one line. On CF bind the aicore service instead.
# Without it the agent uses the built-in rule-based parser.
# AICORE_SERVICE_KEY='{"clientid":"...","clientsecret":"...","url":"...","serviceurls":{"AI_API_URL":"..."}}'
AICORE_MODEL=gpt-4o-mini
# AI_ENABLED=true

# --- App ------------------------------------------------------------------------------------------
# PORT=3000
# AUDIT_LOG_FILE=data/audit.jsonl
# Shared login for a deployed POC URL (leave empty locally)
# APP_BASIC_AUTH_USER=
# APP_BASIC_AUTH_PASSWORD=
